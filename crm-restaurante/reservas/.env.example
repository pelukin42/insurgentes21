# Subdominio que apunta a la IP del VPS (registro A en el DNS)
DOMINIO=reservas.turestaurante.com
# Llave para Sofía y el panel. Generar con: openssl rand -hex 24
API_KEY=
# Opcional: a dónde mandar los eventos (n8n o el CRM). Ej: https://n8n.turestaurante.com/webhook/reservas
WEBHOOK_URL=
# Opcional: secreto para firmar los webhooks (cabecera x-firma = HMAC-SHA256 del cuerpo)
WEBHOOK_SECRET=
# Secretos de las Herramientas del CRM (uno por herramienta, separados por coma).
# Se copian del CRM: Admin → Herramientas → cada herramienta → "Secreto" (cabecera X-Omnicanal-Token)
CRM_TOKENS=
